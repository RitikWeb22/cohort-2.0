# ==============================================================================
# Floorly Platform Environment Configuration Template
# Copy this file to .env and provide your specific credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Network & Environment
PORT=5000
NODE_ENV=development

# Security & Authentication (REQUIRED)
# Must be a cryptographically secure random string with at least 32 characters in production.
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=your_admin_api_override_key_minimum_32_characters
ADMIN_OVERRIDE_ENABLED=false
ADMIN_IP_ALLOWLIST=

# Database & Cache Configuration (REQUIRED)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/floorly?retryWrites=true&w=majority
# Redis Cache (Optional in dev: fallback in-memory cache automatically active if omitted; recommended for 1M+ scale in prod)
REDIS_URL=redis://localhost:6379

# Site & Domain Configuration
SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SUPPORT_EMAIL=support@floorly.com
PRIVACY_EMAIL=privacy@floorly.com

# Public Contact Details (Optional - Leave blank to hide channel on /contact)
CONTACT_EMAIL=support@floorly.com
CONTACT_PHONE=
CONTACT_ADDRESS=
LEGAL_JURISDICTION=

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_PRIMARY_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.7-flash

# Platform Subscription Billing (System 1)
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
# Stripe Credentials (When BILLING_PROVIDER=stripe and BILLING_ENABLED=true)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
# Razorpay Credentials (When BILLING_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Merchant of Record (When BILLING_PROVIDER=merchant-of-record)
MOR_API_KEY=
MOR_WEBHOOK_SECRET=
GRACE_PERIOD_DAYS=7

# Transactional Email Service (Optional - Features disabled if missing)
# Provider 1: Resend
RESEND_API_KEY=
# Provider 2: SMTP Fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Floorly <no-reply@floorly.com>

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
