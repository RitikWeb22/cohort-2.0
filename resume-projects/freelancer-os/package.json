{
  "name": "floorly-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Floorly — Never undercharge again. AI-powered freelance business and proposal platform",
  "type": "module",
  "scripts": {
    "start": "node server/src/index.js",
    "server": "node --watch server/src/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
