# Floorly Server Environment Configuration
PORT=5000
NODE_ENV=development

# Authentication & Database (REQUIRED)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=your_admin_api_override_key_here
MONGO_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/floorly?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379 # In-memory cache fallback active if omitted in dev

# App & Domain URLs
SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SUPPORT_EMAIL=support@floorly.com
PRIVACY_EMAIL=privacy@floorly.com

# Contact & Legal
CONTACT_EMAIL=support@floorly.com
CONTACT_PHONE=
CONTACT_ADDRESS=
LEGAL_JURISDICTION=

# AI Provider
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_PRIMARY_MODEL=gemini-1.5-flash
AI_FALLBACK_MODEL=gemini-1.5-pro

# Platform Subscription Billing
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOR_API_KEY=
MOR_WEBHOOK_SECRET=

# Mailer (Optional)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Floorly <no-reply@floorly.com>
# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here